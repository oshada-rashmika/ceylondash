rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Fallback: Allow authenticated users to read/write any document.
    // This is the most reliable way to resolve immediate permission issues.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Explicitly handle collections for clarity
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /support_chats/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
