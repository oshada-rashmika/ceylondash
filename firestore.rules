rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: role-based access
    match /users/{userId} {
      // Allow a user to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow creation only if the auth UID matches the document ID
      // and the role field is one of the allowed values
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['customer', 'rider', 'seller', 'admin'];

      // Allow update only on own document; role field cannot be changed
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      // Deny delete for all users
      allow delete: if false;
    }

    // Admin: allow reading any user document if the requester is an admin
    match /users/{userId} {
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Orders collection (existing — unchanged)
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
  }
}
